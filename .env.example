# Де слухати. 127.0.0.1 — лише локально (безпечне типове значення).
# Щоб віддати сервіс у VPN-мережу, вкажи адресу тунельного інтерфейсу,
# наприклад BIND_ADDR=10.0.0.1. НЕ став 0.0.0.0, якщо не хочеш віддати
# застосунок усьому інтернету — автентифікації в ньому немає.
BIND_ADDR=127.0.0.1
HOST_PORT=3001

# Джерело даних: siren | ubilling | alerts_in_ua
#   siren       — дзеркало офіційного ukrainealarm v3 (ДСНС): райони й громади, БЕЗ ключа
#   ubilling    — ubilling.net.ua/aerialalerts: лише області, БЕЗ ключа
#   alerts_in_ua— потребує токена, зате віддає готову історію за останній місяць
ALERTS_PROVIDER=siren

# Токен alerts.in.ua — потрібен ЛИШЕ якщо ALERTS_PROVIDER=alerts_in_ua — отримати на https://alerts.in.ua/ (форма запиту доступу)
ALERTS_TOKEN=put_your_token_here

# Куди писати БД всередині контейнера (том alerts-data)
DB_PATH=/data/alerts.db

# Опитування живого статусу, секунди (ліміт API: 8-10 req/min soft, 12 hard)
POLL_INTERVAL=45

# Оновлення каталогу регіонів із джерела, години
REGIONS_REFRESH_HOURS=24

# Backfill історії month_ago, години (тільки для alerts_in_ua; ліміт: 2 req/min)
BACKFILL_INTERVAL_HOURS=12

# Пауза між запитами історії, секунди (2 req/min -> >=31)
BACKFILL_SPACING=35

# Часовий пояс для добових меж
TZ=Europe/Kyiv
